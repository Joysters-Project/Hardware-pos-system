# Backend Environment Variables — copy this file to .env and fill in values

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_database
DB_USER=root
DB_PASS=
DIALECT=mysql

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# Development : http://localhost:5173
# Production  : https://your-domain.com
FRONTEND_URL=http://localhost:5173

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Brevo / Sendinblue (optional) ────────────────────────────────────────────
BREVO_API_KEY=

# ── Email Display Name ────────────────────────────────────────────────────────
EMAIL_FROM_NAME=
EMAIL_FROM_EMAIL=
